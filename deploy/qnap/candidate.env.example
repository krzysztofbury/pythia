# Candidate is forced to PAPER again in compose.yaml.
TRADING_MODE=PAPER
LIVE_ENTRIES_ENABLED=false
KRAKEN_API_KEY=replace-with-paper-key
KRAKEN_PRIVATE_KEY=replace-with-paper-secret
GEMINI_API_KEY=replace-with-gemini-key

QUOTE_CURRENCY=USDC
TRADING_UNIVERSE=BTC/USDC,ETH/USDC,SOL/USDC,AVAX/USDC,DOT/USDC,LINK/USDC,XRP/USDC
MAX_POSITION_SIZE_USD=50.0
SENTIMENT_ENABLED=false
LLM_LIVE_INFLUENCE_ENABLED=false
CHALLENGER_ENABLED=false
LLM_MONTHLY_BUDGET_USD=1.0
LLM_DAILY_SHADOW_BUDGET_USD=0.05
LLM_MAX_TOKENS=512
MAX_DCA_PER_POSITION=0
PARTIAL_EXIT_ENABLED=false
FUNDING_RATES_ENABLED=false
POLYMARKET_ENABLED=true
LOG_RETENTION_DAYS=30
