# Compose interpolation only. Copy to config.env and keep it mode 0600.
COMPOSE_PROJECT_NAME=oracle-pythia
GHCR_IMAGE=ghcr.io/krzysztofbury/pythia
CANDIDATE_TAG=candidate
STABLE_REF=:stable
CANDIDATE_ENV_FILE=candidate.env
LIVE_ENV_FILE=live.env
LEGACY_ARCHIVE_DIR=./archive/v9

# Third-party runtime images. Dependabot tracks these version tags.
WARP_IMAGE=ghcr.io/mon-ius/docker-warp-socks:v6
WATCHTOWER_IMAGE=containrrr/watchtower:1.7.1

# Stable auto-update is an explicit operator choice. Candidate is never watched.
WATCHTOWER_STABLE_SELECTED=false
WATCHTOWER_POLL_INTERVAL=86400
# Required for private GHCR images when the watchtower profile is enabled.
WATCHTOWER_DOCKER_CONFIG_FILE=/absolute/path/to/.docker/config.json
