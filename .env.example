KRAKEN_API_KEY=your_kraken_key
KRAKEN_PRIVATE_KEY=your_kraken_secret
XAI_API_KEY=your_grok_key
XAI_MODEL=grok-4-1-fast-reasoning
CMC_API_KEY=optional_coinmarketcap_key
POLYMARKET_API_KEY=optional_polymarket_key
TRADING_MODE=PAPER
MAX_POSITION_SIZE_USD=50.0
QUOTE_CURRENCY=USDC
TRADING_UNIVERSE="BTC/USDC,ETH/USDC,SOL/USDC,XRP/USDC,DOGE/USDC,SHIB/USDC,LINK/USDC,DOT/USDC,LTC/USDC"
TIMEOUT_SECONDS=3600

# ATR-based dynamic stops (replaces fixed % SL/TP)
USE_ATR_STOPS=true
ATR_SL_MULTIPLIER=2.0
ATR_TP_MULTIPLIER=3.0

# Portfolio risk
MAX_CORRELATED_POSITIONS=3
DAILY_LOSS_LIMIT_USD=20.0

# Position management
POSITION_MAX_AGE_HOURS=72

# Tax rate for profit calculation (default: 0.19 = 19%)
TAX_RATE=0.19

# Notifications (Discord/Slack webhook URL)
WEBHOOK_URL=
ERROR_WEBHOOK_URL=

# Log rotation
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Trailing Stop-Loss
TRAILING_STOP_ENABLED=true
TRAILING_SL_ATR_MULTIPLIER=1.5
BREAKEVEN_ATR_THRESHOLD=1.0

# Time-based ROI decay (minutes:profit_pct pairs)
ROI_ENABLED=true
ROI_SCHEDULE="0:4.0,60:3.0,120:2.0,240:1.0"

# Multi-timeframe analysis
MTF_ENABLED=true
MTF_SHORT_TIMEFRAME=15m
MTF_LONG_TIMEFRAME=4h

# Cycle timing (seconds)
ENTRY_CYCLE_SECONDS=900
FULL_CYCLE_SECONDS=3600

# Partial exits
PARTIAL_EXIT_ENABLED=true
PARTIAL_EXIT_PCT=0.50
PARTIAL_EXIT_ATR_THRESHOLD=2.0

# Optimizer (optional path to optimized params JSON)
OPTIMIZED_PARAMS_FILE=
