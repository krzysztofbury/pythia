# --- Required ---
KRAKEN_API_KEY=your_kraken_key
KRAKEN_PRIVATE_KEY=your_kraken_secret
GEMINI_API_KEY=your_gemini_key

# --- Sentiment LLM (v9.6 — Gemini primary; sentiment is commentary only,
#     never a buy/sell decision) ---
SENTIMENT_MODEL=gemini/gemini-3.5-flash
# Configure a fallback on a DIFFERENT provider so one billing outage cannot
# blind the bot (requires that provider's key, e.g. XAI_API_KEY):
# SENTIMENT_FALLBACK_MODEL=xai/grok-4-1-fast-reasoning
# XAI_API_KEY=your_grok_key
SENTIMENT_CACHE_SECONDS=3600   # per-ticker TTL; 0 disables (NOT recommended)
REQUIRE_BULLISH_SENTIMENT=false  # true = legacy hard gate (LLM outage disables bot)

# --- Core ---
TRADING_MODE=PAPER
QUOTE_CURRENCY=USDC
# v9.5 default: 7 liquid majors in USDC. Operators can add/remove freely.
TRADING_UNIVERSE=BTC/USDC,ETH/USDC,SOL/USDC,AVAX/USDC,DOT/USDC,LINK/USDC,XRP/USDC
MAX_POSITION_SIZE_USD=50.0     # ceiling $500 since v9.2; default remains 50
TIMEOUT_SECONDS=3600

# --- Optional API keys ---
CMC_API_KEY=optional_coinmarketcap_key
POLYMARKET_API_KEY=optional_polymarket_key
# Enable these to use the LLM Challenger or alternate sentiment providers.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- LLM Challenger (v9.1 — ToS-safe, commentary only, never blocks execution) ---
CHALLENGER_ENABLED=false
CHALLENGER_MODEL=anthropic/claude-sonnet-4-5
CHALLENGER_FALLBACK_MODEL=gemini/gemini-3.5-flash

# --- Funding Rates (v9.5 — perp funding as sentiment proxy) ---
FUNDING_RATES_ENABLED=false
FUNDING_RATES_EXCHANGE=binance  # read-only, no orders placed; all symbols → /USDT:USDT perps

# --- Strategy thresholds (v9.0 — all configurable via .env) ---
# Set to override the defaults in src/config.py. Leave unset to use defaults.
# ENTRY_THRESHOLD=0.25
# EXIT_THRESHOLD=-0.05
# DCA_THRESHOLD=0.30
# STRONG_SELL_THRESHOLD=-0.25
# PROFIT_TAKE_PCT=5.0
# MOMENTUM_WEAK_THRESHOLD=0.1
# SMA_OVEREXTENDED_PCT=15.0
# MEAN_REVERSION_RSI=28.0
# MEAN_REVERSION_ADX=30.0
# MEAN_REVERSION_BONUS=0.10
# STALE_POSITION_HOURS=120.0
# STALE_EXIT_PNL_THRESHOLD_PCT=2.0
# MIN_BUY_CONFIDENCE=0.0
# MIN_SELL_CONFIDENCE=0.0

# --- Conviction sizing (v9.2) ---
CONVICTION_SIZING_ENABLED=true
MAX_POSITION_PCT_OF_BALANCE=0.40
# SIZING_TIER_1_THRESHOLD=0.25
# SIZING_TIER_2_THRESHOLD=0.35
# SIZING_TIER_3_THRESHOLD=0.50
# SIZING_TIER_4_THRESHOLD=0.70
# SIZING_TIER_1_MULTIPLIER=0.6
# SIZING_TIER_2_MULTIPLIER=1.0
# SIZING_TIER_3_MULTIPLIER=1.4
# SIZING_TIER_4_MULTIPLIER=2.0

# --- Risk management ---
USE_ATR_STOPS=true
ATR_SL_MULTIPLIER=2.0
ATR_TP_MULTIPLIER=3.0
STOP_LOSS_PCT=0.02                 # fallback when ATR unavailable
TAKE_PROFIT_PCT=0.04               # fallback when ATR unavailable
MAX_SPREAD_PCT=0.005
LIMIT_ORDER_DISCOUNT_PCT=0.002

MAX_CORRELATED_POSITIONS=3         # per correlation group
MAX_TOTAL_CRYPTO_POSITIONS=5       # v9.5 portfolio-wide backstop
DAILY_LOSS_LIMIT_USD=20.0
POSITION_MAX_AGE_HOURS=120         # raised from 72 in v8.1
MAX_DCA_PER_POSITION=1
MAX_ENTRIES_PER_CYCLE=2
STALE_ORDER_MAX_AGE_SECONDS=7200
DYNAMIC_RISK_ENABLED=false         # apply GARCH vol multipliers to SL/TP

# --- Trailing stop-loss ---
TRAILING_STOP_ENABLED=true
TRAILING_SL_ATR_MULTIPLIER=1.5
BREAKEVEN_ATR_THRESHOLD=1.0

# --- Time-based ROI decay ---
ROI_ENABLED=true
ROI_SCHEDULE=0:4.0,60:3.0,120:2.0,240:1.0

# --- Partial exits ---
PARTIAL_EXIT_ENABLED=true
PARTIAL_EXIT_PCT=0.50
PARTIAL_EXIT_ATR_THRESHOLD=2.0

# --- Multi-timeframe analysis ---
MTF_ENABLED=true
MTF_SHORT_TIMEFRAME=15m
MTF_LONG_TIMEFRAME=4h

# --- Cycle timing ---
ENTRY_CYCLE_SECONDS=900     # fast cycle (15 min)
FULL_CYCLE_SECONDS=3600     # full cycle (1 hour)

# --- Technical analysis ---
TA_CANDLE_TIMEFRAME=1h
TA_CANDLE_LIMIT=100
GARCH_ENABLED=true
GARCH_CANDLE_TIMEFRAME=4h
ARIMA_ENABLED=true
POLYMARKET_ENABLED=true
# WARP_PROXY=socks5://127.0.0.1:1080   # if Polymarket is geo-blocked

# --- Tax / notifications / logs ---
TAX_RATE=0.19                         # 19% PL default
WEBHOOK_URL=                          # Discord/Slack trade alerts
ERROR_WEBHOOK_URL=                    # separate channel for errors
LOG_RETENTION_DAYS=30                 # v9.6: 7 days destroyed incident evidence
NO_ENTRY_ALERT_HOURS=72               # v9.6: alert when LIVE bot opens nothing; 0 disables

# --- Optimizer ---
OPTIMIZED_PARAMS_FILE=                # optional path to applied optimizer output
